# Copy to .env (git-ignored) and fill in. In GitHub Actions, set the same names as secrets.

# Postgres. Supabase: Project settings > Database > Connection string (URI).
SI_DATABASE_URL=

# Test mode is on unless this is exactly "live" (ADR-0007). Leave it unset until /go-live.
SI_SEND_MODE=test
# Extra addresses allowed to receive mail in test mode (comma-separated).
SI_ONLY_TO=

# LLMs (ADR-0005). Anthropic is the default; Gemini is an optional free fallback.
SI_ANTHROPIC_API_KEY=
SI_MODEL_JUDGMENT=claude-opus-5-5
SI_MODEL_BULK=claude-haiku-5-5
SI_GEMINI_API_KEY=

# Sending mailbox (sending itself arrives in phase 6; `si check` tests the login now).
SI_SMTP_HOST=
SI_SMTP_PORT=587
SI_SMTP_USER=
SI_SMTP_PASSWORD=
SI_IMAP_HOST=
SI_IMAP_PORT=993
SI_IMAP_USER=
SI_IMAP_PASSWORD=
# DKIM selectors to look for when checking DNS (comma-separated).
SI_DKIM_SELECTORS=default,google,zoho,selector1,selector2,k1

# Tests only: a Postgres server where the suite may create and drop throwaway databases.
SI_TEST_DATABASE_URL=
